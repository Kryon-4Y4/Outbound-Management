! U1 setvar "device.languages" "zpl"
! U1 setvar "media.type" "label"
! U1 setvar "media.sense_mode" "gap"
! U1 setvar "media.printmode" "tear off"
! U1 setvar "ezpl.replace_x_with_dynamic" "static"
! U1 setvar "device.pnp_option" "zpl"
! U1 setvar "ip.protocol" "none"
! U1 setvar "ip.port" "9100"
! U1 setvar "wlan.ip.port" "9100"
! U1 setvar "bluetooth.short_address" "off"
! U1 setvar "bluetooth.enable" "off"
! U1 setvar "bluetooth.discoverable" "off"
! U1 setvar "power.energy_star.enable" "on"
! U1 setvar "power.energy_star_timeout" "15"
! U1 setvar "power.dtr_power_up" "on"
! U1 setvar "power.diagnostics" "on"
! U1 setvar "power.sleep.enable" "off"
! U1 setvar "power.sleep.timeout" "0"
! U1 setvar "display.contrast" "30"
! U1 setvar "display.text_on_time" "30"
! U1 setvar "display.language" "english"
! U1 setvar "device.system_memory" "free"
! U1 setvar "device.configuration_change_alert" "off"
! U1 setvar "file.rename" "E:CONFIG.BAK" "E:CONFIG.BAK.OLD"
! U1 setvar "file.rename" "E:CONFIG.ZPL" "E:CONFIG.BAK"
! U1 setvar "file.type" "E:CONFIG.ZPL" "write"
! U1 setvar "file.name" "E:CONFIG.ZPL"
! U1 setvar "file.contents" "CONFIG.ZPL"
! U1 setvar "file.type" "E:CONFIG.ZPL" "close"
~JC
